# Origin used for metadata and social previews. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini (optional — leave blank to use local feedback templates)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Set to 1 to force the local engine even when GEMINI_API_KEY is present.
MOCK_AI=0
