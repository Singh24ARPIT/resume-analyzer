# Supabase (leave blank to run the browser-only demo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used in confirmation email redirects. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini (leave blank to use the local feedback templates)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Set to 1 to force the local engine even when GEMINI_API_KEY is present.
MOCK_AI=0
